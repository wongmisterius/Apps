{
  "package": "com.danilopopelec.tamagotchi",
  "name": "Mascota Virtual",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1070,
  "icon": "/Common/logo.png",
  "features": [
    { "name": "system.storage" },
    { "name": "system.prompt" },
    { "name": "system.device" },
    { "name": "system.router" }
  ],
  "permissions": [
    { "origin": "*" }
  ],
  "config": {
    "logLevel": "log"
  },
  "router": {
    "entry": "home",
    "pages": {
      "home": {
        "component": "index",
        "path": "/pages/home"
      }
    }
  },
  "display": {
    "titleBarText": "Mascota",
    "menu": false,
    "pages": {
      "home": {
        "titleBar": false,
        "statusBar": false,
        "fullScreen": true
      }
    }
  },
  "deviceType": [ "liteWearable", "smartVision" ]
}
